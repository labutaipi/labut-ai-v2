generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTENTICAÇÃO (Better Auth — não alterar)
// ─────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Dados do negócio do MEI
  businessName   String?
  segmentSlug    String? // "salao-beleza" | "alimentacao" | ...
  citySlug       String? // "teresina" | "parnaiba" | ...
  targetAudience String? // "mulheres-adultas" | "familias" | "jovens" | "homens-adultos" | "todos"
  plan           Plan    @default(FREE)

  sessions        Session[]
  accounts        Account[]
  insights        AIInsight[]
  businessProfile BusinessProfile?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  password             String?   @db.Text
  accessToken          String?   @db.Text
  refreshToken         String?   @db.Text
  idToken              String?   @db.Text
  accessTokenExpiresAt DateTime?
  scope                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenExpiresAt DateTime?

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────
// CACHE DE TENDÊNCIAS
// Chave: segmentSlug + citySlug
// UMA entrada serve TODOS os usuários do mesmo segmento + cidade
// ─────────────────────────────────────────

model SegmentTrendsCache {
  id          String   @id @default(cuid())
  segmentSlug String
  citySlug    String
  dataType    String // "interest_over_time" | "by_region" | "related_queries"
  geoUsed     String // geo code usado: "BR-PI-TEI" ou "BR-PI" (fallback)
  payload     Json
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime // TTL: 12 horas

  @@unique([segmentSlug, citySlug, dataType])
}

// ─────────────────────────────────────────
// INSIGHTS GERADOS POR IA
// ─────────────────────────────────────────

model AIInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String // JSON serializado: { emAlta, oportunidade, acao }
  dataHash    String // hash dos dados de entrada (evita regenerar sem mudança)
  generatedAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// GOOGLE BUSINESS PROFILE (via SerpAPI)
// ─────────────────────────────────────────

model BusinessProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId     String?
  name        String
  rating      Float?
  reviewCount Int?
  syncedAt    DateTime         @default(now())
  reviews     BusinessReview[]
}

model BusinessReview {
  id          String          @id @default(cuid())
  profileId   String
  profile     BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  author      String
  rating      Int
  comment     String?
  publishedAt DateTime

  @@index([profileId])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Plan {
  FREE
  PREMIUM
}
